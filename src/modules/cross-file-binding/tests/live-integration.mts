const built=await post(base+'/cross-file/index');assert.equal(built.status,'partial');assert.equal(built.counts.modules,30);assert.deepEqual(await(await fetch(base+'/cross-file')).json(),built);const q=(body:unknown)=>post(base+'/cross-file/query',body),bindingRequest={schemaVersion:1,kind:'bindings',relativePath:'consumer.jsx',limit:100},bindings=await q(bindingRequest),referenceRequest={schemaVersion:1,kind:'references',relativePath:'consumer.jsx',limit:100},references=await q(referenceRequest);
const binding=(alias:string)=>bindings.results.find((b:any)=>b.localAlias===alias);for(const alias of ['café','sum','Run','Tool','viaLocal','barrel','other','diamond','explicit','Named'])assert.equal(binding(alias).status,'established_declaration',alias);for(const alias of ['anonymous','anonymousClass','expression','repeated'])assert.equal(binding(alias).status,'established_export_slot',alias);assert.equal(binding('ambiguous').status,'ambiguous_target');assert.equal(binding('cyclicAmbiguous').status,'ambiguous_target');assert.equal(binding('loop').status,'unresolved_export');assert.equal(binding('missing').status,'unresolved_import');assert.equal(binding('hyphen').claims.lexicalBinding,false);
const sumRefs=references.results.filter((r:any)=>r.bindingId===binding('sum').id);assert.equal(sumRefs.length,3);assert(sumRefs.every((r:any)=>r.status==='established_declaration'&&r.claims.reference));const localLexical=modules.inputs.files.find(f=>f.relativePath==='consumer.jsx')!.resolution!;for(const shadow of localLexical.references.filter(r=>r.name==='sum'&&r.symbolId!==binding('sum').localSymbolId))assert(!references.results.some((r:any)=>r.referenceId===shadow.id));assert(binding('viaLocal').candidates[0].steps.filter((s:any)=>s.kind==='imported_local').length===2);
const namespaceRequest={schemaVersion:1,kind:'namespaces',relativePath:'namespace.js',limit:100},namespace=await q(namespaceRequest);assert(namespace.results.some((n:any)=>n.form==='literal'&&n.status==='established_declaration'));assert(namespace.results.some((n:any)=>n.status==='unsupported_syntax'));assert(namespace.results.some((n:any)=>n.status==='ambiguous_target'));const chainRequest={schemaVersion:1,kind:'chains',relativePath:'local2.js',exportedName:'final'},chain=await q(chainRequest);assert.equal(chain.results[0].status,'established_declaration');assert((await q({schemaVersion:1,kind:'ambiguous'})).total>0);assert((await q({schemaVersion:1,kind:'unresolved'})).total>0);
const document=await new FileBindingStore(w).get(imported.projectId,a.analysisId);assert.equal(document.artifactId,built.artifactId);assert.equal(document.moduleDocumentHash,moduleHash);assert(!JSON.stringify(document).includes('UNVERIFIED_MUTATION'));assert.equal(digest(await new FileModuleStore(w).get(imported.projectId,a.analysisId)),moduleHash);assert.equal(digest(await new FileGraphStore(w).get(imported.projectId,a.analysisId)),graphHash);assert.deepEqual(await(await fetch(base+'/graph')).json(),graph);const core=document.input.inputs.files.find(f=>f.relativePath==='core.js')!;assert(core.source!.startsWith('\ufeff'));assert(core.source!.includes('\r\n'));assert(core.source!.includes('😀'));for(const ref of document.references){const source=sources[ref.relativePath]!;assert.equal(source.slice(ref.range.start.offset,ref.range.end.offset),ref.name);}
