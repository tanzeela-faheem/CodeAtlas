child.kill('SIGTERM');await once(child,'exit');server.closeAllConnections();await new Promise<void>(r=>server.close(()=>r()));const launch="import {createApp} from './src/app.ts';const s=createApp().listen(0,'127.0.0.1',()=>console.log('READY '+s.address().port));",restart=spawn(process.execPath,['--import','tsx','--input-type','module','-e',launch],{env:{...process.env,WORKSPACE_ROOT:f.storage},stdio:['ignore','pipe','pipe']});try{const p=await ready(restart),persisted=base.replace(node,`http://127.0.0.1:${p}`);assert.deepEqual(await(await fetch(persisted+'/cross-file')).json(),built);for(const [request,expected] of [[bindingRequest,bindings],[referenceRequest,references],[namespaceRequest,namespace],[chainRequest,chain]])assert.deepEqual(await post(persisted+'/cross-file/query',request),expected);assert.deepEqual(await post(persisted+'/cross-file/index'),built);assert.deepEqual(await(await fetch(persisted+'/graph')).json(),graph);assert.deepEqual(await post(persisted+'/search/query',exactRequest),exact);assert.deepEqual(await(await fetch(persisted+'/search')).json(),index);}finally{restart.kill('SIGTERM');await once(restart,'exit');}
console.log(JSON.stringify({result:'PASS',workflow:'real import/AST/Python metadata/lexical/relationships/Graph/Phase1/Phase2/reference+shadowing+namespace+reexport queries/mutation/Graph+Search1+2+AIContext/separate Node restart with Python offline',counts:document.counts,sourceExecuted:false,externalLLM:false,phase1Unchanged:true,graphUnchanged:true}));
