/** Real isolated producers, no source execution or external LLM. */
import fs from 'node:fs/promises';
import path from 'node:path';
import http from 'node:http';
import {once} from 'node:events';
import {spawn} from 'node:child_process';
import {createInterface} from 'node:readline';
import assert from 'node:assert/strict';
import {createApp} from '../../../app.js';
import {fixture} from '../../../test/fixtures.js';
import {WorkspaceManagerService} from '../../respository/services/workspace-manager.service.js';
import {FileModuleStore} from '../storage.js';
import {FileGraphStore} from '../../knowledge-graph/storage/GraphStore.js';
import {digest} from '../../symbol-resolution/integration/contracts.js';
const python=process.env.CODEATLAS_PYTHON_EXECUTABLE,repository=process.env.CODEATLAS_PYTHON_REPOSITORY;
if(!python||!repository)throw Error('Set read-only Python executable/repository explicitly');
const f=await fixture({'lib/math.js':'\ufeffexport function add(a,b){return a+b;}\r\nexport default function main(){return add(1,2);}\r\nexport const café="😀";\r\nthrow "DO_NOT_EXECUTE";', 'lib/other.js':'export const add=2;', 'setup.js':'throw "DO_NOT_EXECUTE";', 'barrel.js':'export {add as total,default as Main} from "./lib/math.js";', 'conflict.js':'export * from "./lib/math.js"; export * from "./lib/other.js";', 'cycle-a.js':'export * from "./cycle-b.js"; export const a=1;', 'cycle-b.js':'export * from "./cycle-a.js"; export const b=2;', 'consumer.jsx':'import Main,{add as sum} from "./lib/math.js"; import * as ns from "./lib/math.js"; import "./setup.js"; import {total} from "./barrel.js"; import {add as ambiguous} from "./conflict.js"; import {b} from "./cycle-a.js"; import missing from "./missing.js"; import pkg from "external"; const view=<Thing/>; throw "DO_NOT_EXECUTE";', 'unsupported.ts':'const x:number=1;'});
const server=http.createServer();server.listen(0,'127.0.0.1');await once(server,'listening');const node=`http://127.0.0.1:${(server.address() as import('node:net').AddressInfo).port}`;
const program=`import socket,uvicorn
from fastapi import FastAPI
from app.metadata.routes import v2_router
app=FastAPI()
app.include_router(v2_router)
s=socket.socket()
s.bind(('127.0.0.1',0))
print('READY '+str(s.getsockname()[1]),flush=True)
uvicorn.Server(uvicorn.Config(app,log_level='error',lifespan='off')).run(sockets=[s])`;
const child=spawn(python,['-B','-c',program],{env:{...process.env,PYTHONDONTWRITEBYTECODE:'1',PYTHONPATH:repository,CODEATLAS_AST_BASE_URL:node,CODEATLAS_METADATA_ROOT:path.join(f.root,'metadata')},stdio:['ignore','pipe','pipe']});
let stderr='';child.stderr.on('data',b=>stderr+=b);
async function ready(c:typeof child){return new Promise<number>((resolve,reject)=>{const timer=setTimeout(()=>reject(Error('startup timeout '+stderr)),10000);c.once('error',e=>{clearTimeout(timer);reject(e);});c.once('exit',()=>{clearTimeout(timer);reject(Error('startup exit '+stderr));});createInterface({input:c.stdout}).on('line',line=>{if(line.startsWith('READY ')){clearTimeout(timer);resolve(Number(line.slice(6)));}});});}
async function post(url:string,body:unknown={}){const r=await fetch(url,{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify(body)}),v=await r.json() as any;assert.equal(r.status,200,JSON.stringify(v));return v;}
try{const port=await ready(child);process.env.CODEATLAS_METADATA_BASE_URL=`http://127.0.0.1:${port}`;process.env.CODEATLAS_TRUSTED_IMPORTS='true';process.env.CODEATLAS_AI_ENABLED='false';const w=new WorkspaceManagerService(f.storage);server.on('request',createApp(w));const imported=await post(node+'/api/repository/import',{sourceType:'local',source:f.source});assert.equal(imported.status,'imported');const r=await fetch(`${node}/api/projects/${imported.projectId}/analysis`,{method:'POST'});assert.equal(r.status,202);const a=await r.json() as any,base=`${node}/api/projects/${imported.projectId}/analysis/${a.analysisId}`;
let terminal=false;for(let i=0;i<300;i++){const state=await(await fetch(base)).json() as any;if(['completed','completed_with_errors'].includes(state.status)){terminal=true;break;}await new Promise(r=>setTimeout(r,10));}assert(terminal);
await post(`http://127.0.0.1:${port}/api/v2/metadata/projects/${imported.projectId}/analyses/${a.analysisId}/extract`);await post(base+'/resolve');await post(base+'/relationships');const graph=await post(base+'/graph'),before=digest(await new FileGraphStore(w).get(imported.projectId,a.analysisId));
const built=await post(base+'/modules/index');assert.equal(built.status,'partial');assert.equal(built.counts.modules,9);assert.deepEqual(await(await fetch(base+'/modules')).json(),built);const q=(body:unknown)=>post(base+'/modules/query',body);const imports=await q({schemaVersion:1,kind:'imports',relativePath:'consumer.jsx'}),links=await q({schemaVersion:1,kind:'links',relativePath:'consumer.jsx'});for(const alias of ['Main','sum','ns','total','b']){const i=imports.results.find((i:any)=>i.localName===alias);assert(i);assert.equal(links.results.find((l:any)=>l.importId===i.id).status,'established');}for(const [alias,status] of [['ambiguous','ambiguous_export'],['missing','unresolved_module'],['pkg','unsupported_resolution']])assert.equal(links.results.find((l:any)=>l.importId===imports.results.find((i:any)=>i.localName===alias).id).status,status);const chainRequest={schemaVersion:1,kind:'chains',relativePath:'barrel.js',exportedName:'total'},chain=await q(chainRequest);assert.equal(chain.results[0].candidates[0].chain.length,2);assert((await q({schemaVersion:1,kind:'unresolved'})).total>=3);assert((await q({schemaVersion:1,kind:'diagnostics'})).total>0);
const store=new FileModuleStore(w),d=await store.get(imported.projectId,a.analysisId);assert.equal(d.artifactId,built.artifactId);assert.equal(digest(await new FileGraphStore(w).get(imported.projectId,a.analysisId)),before);assert.deepEqual(await(await fetch(base+'/graph')).json(),graph);const math=d.inputs.files.find(f=>f.relativePath==='lib/math.js')!;assert(math.source!.startsWith('\ufeff'));assert(math.source!.includes('\r\n'));for(const e of d.exports.filter(e=>e.moduleId===d.modules.find(m=>m.relativePath==='lib/math.js')!.id))assert.equal(math.source!.slice(e.syntax.textRange!.start.offset,e.syntax.textRange!.end.offset),e.syntax.text);
const search=await post(base+'/search/index');const exactRequest={schemaVersion:1,mode:'exact',query:'add',filters:{entityKind:'function',path:'lib/math.js'}},exact=await post(base+'/search/query',exactRequest);assert(exact.total>0);await post(base+'/search/index',{schemaVersion:2});const phrase=await post(base+'/search/query',{schemaVersion:2,mode:'text_phrase',query:'return a+b;'});assert(phrase.total>0);const ctx=await post(base+'/ai/context',{schemaVersion:1,userQuestion:'Explain retained module evidence',strategy:'focused',focus:[{type:'file',relativePath:'lib/math.js'}],categories:['metadata','source']});assert(ctx.context.evidence.length>0);
await fs.writeFile(path.join(f.storage,imported.projectId,'repository','lib/math.js'),'throw "UNVERIFIED_MUTATION";');assert.equal((await fetch(base+'/source?path=lib/math.js')).status,409);assert.deepEqual(await post(base+'/modules/index'),built);assert.deepEqual(await q(chainRequest),chain);assert(!JSON.stringify(await q({schemaVersion:1,kind:'exports'})).includes('UNVERIFIED_MUTATION'));assert.deepEqual(await post(base+'/search/query',exactRequest),exact);
child.kill('SIGTERM');await once(child,'exit');server.closeAllConnections();await new Promise<void>(r=>server.close(()=>r()));const launch="import {createApp} from './src/app.ts'; const s=createApp().listen(0,'127.0.0.1',()=>console.log('READY '+s.address().port));",restart=spawn(process.execPath,['--import','tsx','--input-type','module','-e',launch],{env:{...process.env,WORKSPACE_ROOT:f.storage},stdio:['ignore','pipe','pipe']});try{const p=await ready(restart),persisted=base.replace(node,`http://127.0.0.1:${p}`);assert.deepEqual(await(await fetch(persisted+'/modules')).json(),built);assert.deepEqual(await post(persisted+'/modules/query',chainRequest),chain);assert.deepEqual(await post(persisted+'/modules/index'),built);assert.deepEqual(await(await fetch(persisted+'/graph')).json(),graph);assert.deepEqual(await post(persisted+'/search/query',exactRequest),exact);assert.deepEqual(await(await fetch(persisted+'/search')).json(),search);}finally{restart.kill('SIGTERM');await once(restart,'exit');}
console.log(JSON.stringify({result:'PASS',workflow:'real import/AST/Python metadata/lexical/relationships/Graph/module build/query/projection validation/Search 1+2/AI context/mutation/separate Node restart with Python offline',modules:d.counts.modules,imports:d.counts.imports,exports:d.counts.exports,links:d.counts.links,sourceExecuted:false,externalLLM:false,graphUnchanged:true}));
}finally{if(child.exitCode===null&&child.signalCode===null){child.kill('SIGTERM');await once(child,'exit');}if(server.listening){server.closeAllConnections();await new Promise<void>(r=>server.close(()=>r()));}await f.cleanup();}
