WORKSPACE_ROOT=./storage/workspaces
# Enable only for trusted single-user loopback development, never behind a public proxy.
CODEATLAS_TRUSTED_IMPORTS=false

# Trusted local Python metadata service; Symbol Resolution consumes completed results via GET.
CODEATLAS_METADATA_BASE_URL=http://127.0.0.1:8000

# External repository-data egress: disabled by default. Enable deliberately on loopback only.
CODEATLAS_AI_ENABLED=false
CODEATLAS_AI_PROVIDER=openai
# Explicit supported model; not selected automatically.
CODEATLAS_AI_MODEL=gpt-4.1-mini
# Set OPENAI_API_KEY securely in the server environment; never put a real key in this file.
CODEATLAS_AI_TIMEOUT_MS=30000
CODEATLAS_AI_MAX_OUTPUT_TOKENS=2048
CODEATLAS_AI_MAX_INPUT_BYTES=131072
# Conservative estimated input tokens + output must fit this cap.
CODEATLAS_AI_MAX_CONTEXT_TOKENS=131072
CODEATLAS_AI_MAX_CONCURRENT=1
